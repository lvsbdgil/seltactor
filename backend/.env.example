# Copy to backend/.env. Never place this key in frontend or VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Single administrator. Store only a salted scrypt hash, never a plaintext password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# true only when serving behind HTTPS; false for localhost HTTP.
COOKIE_SECURE=false
